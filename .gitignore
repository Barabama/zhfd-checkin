config.toml
**/config.toml
config.toml.bak.*
**/config.toml.bak.*
backups/
**/backups/
reports/
**/reports/
**/captures/

# 大文件归档
*.zip
*.vdi

# 系统文件
Thumbs.db
desktop.ini
